# Machine-local paths. Copy to `.env` (gitignored) and adjust.
#
# Both are consumed by configs/*.yaml through ${VAR} expansion in config.py,
# which raises if either is unset rather than producing a literal path.
#
# SLEEP_RAW_ROOT   parent of the per-cohort raw data directories
#                       (MASS-2020/, CFS/, HomePAP/, MrOS/, SOF/, BitBrain/,
#                        DREAMS/, ANPHY/, YSYW/, DOD-H/)
# SLEEP_DATA_ROOT  where preprocessed corpora (prepared/) and run outputs
#                       (runs/) are written. Keep this on a native Linux
#                       filesystem -- training memory-maps the arrays with
#                       random access, which is pathological over a 9p/drvfs
#                       mount even though sequential reads there are fast.

SLEEP_RAW_ROOT=/path/to/raw/cohorts
SLEEP_DATA_ROOT=/path/to/data

# S3 credentials for the streamed cohorts (WSC). boto3 reads these
# directly from the environment, so no key is ever written into the repo, a
# config, or a log line. A boto3 profile or instance role works too.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
